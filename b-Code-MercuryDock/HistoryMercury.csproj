<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;**\bin\**;**\obj\**</DefaultItemExcludes>
    <AssemblyName>HistoryMercury</AssemblyName>
    <RootNamespace>Mercury</RootNamespace>
    <Version>4.6.0</Version>
  </PropertyGroup>
  <PropertyGroup>
    <HistoryVulcanCoreProj>$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\b-Code-HistoryVulcan\src\HistoryVulcan.Core\HistoryVulcan.Core.csproj</HistoryVulcanCoreProj>
    <HistoryVulcanShellProj>$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\b-Code-HistoryVulcan\src\HistoryVulcan.Shell\HistoryVulcan.Shell.csproj</HistoryVulcanShellProj>
    <HistoryVulcanServicesProj>$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\b-Code-HistoryVulcan\src\HistoryVulcan.Services\HistoryVulcan.Services.csproj</HistoryVulcanServicesProj>
    <!-- 演进层：CommandSurface 与命令工作台契约的家；不受宿主冻结门禁约束，随交互形态迭代。 -->
    <HistoryVulcanExtensibilityProj>$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\b-Code-HistoryVulcan\src\HistoryVulcan.Extensibility\HistoryVulcan.Extensibility.csproj</HistoryVulcanExtensibilityProj>
    <!--
      模块对宿主的依赖面是 z 快照，和 project.manifest.json 的 externalDependencies 一致：
      默认永远编译到 z-HistoryVulcan/host 里那份"正在跑的"宿主二进制。

      4.5.1 的事故就出在这里：这里原本写的是"只要 Vulcan 源码树存在就用 ProjectReference"，
      于是宿主工作区一有未发布的在途改动，模块就会链接到根本没在运行的宿主，装载时在 WPF
      视图构造处抛 connectionId 异常，桌面坞被静默吞掉。源码联调必须显式表态。
    -->
    <HistoryVulcanSourceAvailable Condition="'$(HistoryVulcanSourceAvailable)' == ''">false</HistoryVulcanSourceAvailable>
    <HistoryVulcanCoreDll Condition="'$(HistoryVulcanCoreDll)' == ''">$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\z-HistoryVulcan\host\HistoryVulcan.Core.dll</HistoryVulcanCoreDll>
    <HistoryVulcanExtensibilityDll Condition="'$(HistoryVulcanExtensibilityDll)' == ''">$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\z-HistoryVulcan\host\HistoryVulcan.Extensibility.dll</HistoryVulcanExtensibilityDll>
    <HistoryVulcanShellDll Condition="'$(HistoryVulcanShellDll)' == ''">$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\z-HistoryVulcan\host\HistoryVulcan.Shell.dll</HistoryVulcanShellDll>
    <HistoryVulcanServicesDll Condition="'$(HistoryVulcanServicesDll)' == ''">$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\z-HistoryVulcan\host\HistoryVulcan.Services.dll</HistoryVulcanServicesDll>
  </PropertyGroup>
  <ItemGroup Condition="'$(HistoryVulcanSourceAvailable)' == 'true'">
    <ProjectReference Include="$(HistoryVulcanCoreProj)">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(HistoryVulcanExtensibilityProj)">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(HistoryVulcanShellProj)">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(HistoryVulcanServicesProj)">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(HistoryVulcanSourceAvailable)' != 'true'">
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanCoreDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Extensibility">
      <HintPath>$(HistoryVulcanExtensibilityDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Shell">
      <HintPath>$(HistoryVulcanShellDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Services">
      <HintPath>$(HistoryVulcanServicesDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!--
    两条引用路径各自把自己的前提检查掉，免得缺文件时报成一堆"找不到类型"。
    源码联调是显式选择，选了就必须真的有源码树；默认路径则必须先有已发布的 z 宿主。
  -->
  <Target Name="AssertHistoryVulcanReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(HistoryVulcanSourceAvailable)' == 'true' and !Exists('$(HistoryVulcanCoreProj)')"
           Text="HistoryVulcanSourceAvailable=true 但找不到宿主源码工程：$(HistoryVulcanCoreProj)" />
    <Error Condition="'$(HistoryVulcanSourceAvailable)' != 'true' and !Exists('$(HistoryVulcanCoreDll)')"
           Text="找不到已发布的宿主快照：$(HistoryVulcanCoreDll)。先发布 HistoryVulcan，或显式传 -p:HistoryVulcanSourceAvailable=true 对源码树联调。" />
  </Target>
</Project>
