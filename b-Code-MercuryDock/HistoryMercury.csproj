<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>HistoryMercury</AssemblyName>
    <RootNamespace>Mercury</RootNamespace>
    <Version>5.0.4</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj/**;tests/**" />
    <EmbeddedResource Remove="obj/**;tests/**" />
    <None Remove="obj/**;tests/**" />
    <InternalsVisibleTo Include="HistoryVulcan.Tests" />
    <InternalsVisibleTo Include="HistoryMercury.Smoke" />
  </ItemGroup>
  <ItemGroup>
    <!--
      运行包的清单必须落进构建输出：宿主的进程内发布管线按登记表
      （module-publish.manifest.json 的 package.files）直接从输出目录取
      dll / xml / module.manifest.json，它不会去跑本仓的打包脚本。
      少了这一行，管线在构建成功之后才报"缺少预期产物"，而本地构建一切正常。
    -->
    <None Update="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <HistoryVulcanCoreProj>$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\b-Code-HistoryVulcan\HistoryVulcan.Core\HistoryVulcan.Core.csproj</HistoryVulcanCoreProj>
    <HistoryVulcanServicesProj>$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\b-Code-HistoryVulcan\HistoryVulcan.Services\HistoryVulcan.Services.csproj</HistoryVulcanServicesProj>
    <!--
      模块对宿主的依赖面是 z 快照，和 project.manifest.json 的 externalDependencies 一致：
      默认永远编译到 z-Publish/host 里那份"正在跑的"宿主二进制。

      4.5.1 的事故就出在这里：这里原本写的是"只要 Vulcan 源码树存在就用 ProjectReference"，
      于是宿主工作区一有未发布的在途改动，模块就会链接到根本没在运行的宿主，装载时在 WPF
      视图构造处抛 connectionId 异常，桌面坞被静默吞掉。源码联调必须显式表态。
    -->
    <HistoryVulcanSourceAvailable Condition="'$(HistoryVulcanSourceAvailable)' == ''">false</HistoryVulcanSourceAvailable>
    <!-- AI 工作树落在库根之外，相对路径必然指空；diana.worktree.create 生成的
         Directory.Build.user.props 会设定 HistoryVulcanPackageRoot，这里据此推导。 -->
    <HistoryVulcanPublishRoot Condition="'$(HistoryVulcanPublishRoot)' == ''">$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPublishRoot>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == '' and Exists('$(HistoryVulcanPublishRoot)\manifest.json')">$(HistoryVulcanPublishRoot)</HistoryVulcanPackageRoot>
    <HistoryVulcanHostDir Condition="'$(HistoryVulcanHostDir)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostDir>
    <HistoryVulcanCoreDll Condition="'$(HistoryVulcanCoreDll)' == ''">$(HistoryVulcanHostDir)\HistoryVulcan.Core.dll</HistoryVulcanCoreDll>
    <HistoryVulcanServicesDll Condition="'$(HistoryVulcanServicesDll)' == ''">$(HistoryVulcanHostDir)\HistoryVulcan.Services.dll</HistoryVulcanServicesDll>
  </PropertyGroup>
  <ItemGroup Condition="'$(HistoryVulcanSourceAvailable)' == 'true'">
    <ProjectReference Include="$(HistoryVulcanCoreProj)">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(HistoryVulcanServicesProj)">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(HistoryVulcanSourceAvailable)' != 'true'">
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanCoreDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Services">
      <HintPath>$(HistoryVulcanServicesDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!--
    两条引用路径各自把自己的前提检查掉，免得缺文件时报成一堆"找不到类型"。
    源码联调是显式选择，选了就必须真的有源码树；默认路径则必须先有已发布的 z 宿主。
  -->
  <Target Name="AssertHistoryVulcanReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(HistoryVulcanSourceAvailable)' == 'true' and !Exists('$(HistoryVulcanCoreProj)')"
           Text="HistoryVulcanSourceAvailable=true 但找不到宿主源码工程：$(HistoryVulcanCoreProj)" />
    <Error Condition="'$(HistoryVulcanSourceAvailable)' != 'true' and !Exists('$(HistoryVulcanCoreDll)')"
           Text="找不到已发布的宿主快照：$(HistoryVulcanCoreDll)。先发布 HistoryVulcan，或显式传 -p:HistoryVulcanSourceAvailable=true 对源码树联调。" />
  </Target>
</Project>
