<UserControl x:Class="Mercury.CommandSurface.McpToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!--
        视图不带本地字典:样式一律 DynamicResource,沿可视树取宿主界面的资源。
        本地合并 Aurora 样式字典只能覆盖它自己那一份键,漏的那些会以
        StaticResourceExtension 异常整页炸掉(管理页栽过一次)。
    -->

    <DockPanel Margin="10">
        <!--
            3.2.1:顶部只保留有效的域/类/MCP 筛选和刷新动作，
            段间用发丝线切分，窄宽度下整条自动换行。
        -->
        <Border DockPanel.Dock="Top" Style="{DynamicResource Aurora.Segment.Bar}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="域" Style="{DynamicResource Aurora.Segment.Label}" />
                <ComboBox x:Name="DomainFilterBox" Width="130"
                          Style="{DynamicResource Aurora.Segment.ComboBox}"
                          SelectionChanged="OnDomainFilterChanged" />
                <TextBlock Text="类" Style="{DynamicResource Aurora.Segment.Label}" />
                <ComboBox x:Name="ClassFilterBox" Width="110"
                          Style="{DynamicResource Aurora.Segment.ComboBox}"
                          SelectionChanged="OnClassFilterChanged" />
                <TextBlock Text="MCP" Style="{DynamicResource Aurora.Segment.Label}" />
                <ComboBox x:Name="McpFilterBox" Width="120" SelectedIndex="0"
                          Style="{DynamicResource Aurora.Segment.ComboBox}"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="当前可见" />
                    <ComboBoxItem Content="当前隐藏" />
                    <ComboBoxItem Content="硬排除" />
                    <ComboBoxItem Content="危险拒绝" />
                </ComboBox>
                <Border Style="{DynamicResource Aurora.Segment.Divider}" />
                <Button x:Name="RefreshButton" Content="刷新"
                        Style="{DynamicResource Aurora.Segment.Button}" Click="OnRefreshClick" />
            </WrapPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText"
                   Foreground="{DynamicResource Aurora.Brush.TextSecondary}"
                   FontSize="{DynamicResource Aurora.Font.Small}"
                   Margin="2,8,0,0"
                   Text="命令注册表是能力真值；MCP 只是策略投影" TextWrapping="Wrap" />

        <ListView x:Name="ToolList" Margin="0,8,0,0" SelectionChanged="OnToolSelected">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{DynamicResource Aurora.GridHeader}">
                    <GridViewColumn Header="域" Width="90" DisplayMemberBinding="{Binding Domain}" />
                    <GridViewColumn Header="类" Width="90" DisplayMemberBinding="{Binding CommandClass}" />
                    <GridViewColumn Header="方法" Width="120" DisplayMemberBinding="{Binding Method}" />
                    <GridViewColumn Header="MCP" Width="85" DisplayMemberBinding="{Binding McpState}" />
                    <GridViewColumn Header="参数" Width="48" DisplayMemberBinding="{Binding ParameterCount}" />
                    <GridViewColumn Header="说明" Width="340" DisplayMemberBinding="{Binding Summary}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
