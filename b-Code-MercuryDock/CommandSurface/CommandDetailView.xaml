<UserControl x:Class="Mercury.CommandSurface.CommandDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!--
        视图不带本地字典:样式一律 DynamicResource,沿可视树取宿主界面的资源。
        本地合并 Aurora 样式字典只能覆盖它自己那一份键,漏的那些会以
        StaticResourceExtension 异常整页炸掉(管理页栽过一次)。
    -->

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="{DynamicResource Aurora.Brush.TextSecondary}"
                   Margin="0,6,0,0" TextWrapping="Wrap" />

        <TabControl x:Name="DetailTabs" IsEnabled="False">
            <TabItem Header="帮助">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="SummaryBox" IsReadOnly="True" TextWrapping="Wrap"
                             Background="{DynamicResource Aurora.Brush.SurfaceAlt}" MaxHeight="80" />
                    <TextBlock Grid.Row="1" Text="参数" Foreground="{DynamicResource Aurora.Brush.TextSecondary}" FontSize="{DynamicResource Aurora.Font.Small}" Margin="0,8,0,2" />
                    <ListView Grid.Row="2" x:Name="ParameterList">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{DynamicResource Aurora.GridHeader}">
                                <GridViewColumn Header="名称" Width="100" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="类型" Width="65" DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="必填" Width="48" DisplayMemberBinding="{Binding Required}" />
                                <GridViewColumn Header="默认" Width="90" DisplayMemberBinding="{Binding Default}" />
                                <GridViewColumn Header="说明" Width="280" DisplayMemberBinding="{Binding Description}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBox Grid.Row="3" x:Name="ExampleBox" IsReadOnly="True" Margin="0,8,0,0"
                             FontFamily="{DynamicResource Aurora.Font.MonoFamily}" Background="{DynamicResource Aurora.Brush.SurfaceAlt}" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="查看帮助" Click="OnHelpClick" />
                        <Button x:Name="CopyExampleButton" Content="复制示例" Margin="8,0,0,0"
                                Click="OnCopyExampleClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="MCP">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="McpStatusText" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="JSON 输入结构" Foreground="{DynamicResource Aurora.Brush.TextSecondary}" FontSize="{DynamicResource Aurora.Font.Small}"
                               Margin="0,8,0,2" />
                    <TextBox Grid.Row="2" x:Name="SchemaBox" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="{DynamicResource Aurora.Font.MonoFamily}" Background="{DynamicResource Aurora.Brush.SurfaceAlt}" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    <Button Grid.Row="3" x:Name="ShowSchemaButton" Content="控制台查看 MCP 形态"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnSchemaClick" />
                </Grid>
            </TabItem>

            <TabItem Header="MCP 描述">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="RevisionStatusText" Foreground="{DynamicResource Aurora.Brush.TextSecondary}"
                               Text="当前修订: (默认)" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="默认指令摘要" Foreground="{DynamicResource Aurora.Brush.TextSecondary}"
                               FontSize="{DynamicResource Aurora.Font.Small}" Margin="0,6,0,2" />
                    <TextBox Grid.Row="2" x:Name="DefaultDescBox" IsReadOnly="True"
                             Foreground="{DynamicResource Aurora.Brush.TextSecondary}"
                             Background="{DynamicResource Aurora.Brush.SurfaceAlt}" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Grid.Row="3" Text="提示治理由外部工具负责；宿主仅显示命令目录中的只读状态。"
                               Foreground="{DynamicResource Aurora.Brush.TextSecondary}"
                               FontSize="{DynamicResource Aurora.Font.Small}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
